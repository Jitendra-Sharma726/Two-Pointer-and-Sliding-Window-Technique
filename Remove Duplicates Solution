## 🚀 Python 3 Implementation

```python
def subarraysWithKDistinct(arr: list[int], k: int) -> int:
    """
    Computes the number of contiguous subarrays that contain exactly k distinct integers.
    """
    def atMostK(target_k: int) -> int:
        if target_k <= 0:
            return 0
            
        count = 0
        left = 0
        freq = {}
        
        for right in range(len(arr)):
            # Add current element to window
            freq[arr[right]] = freq.get(arr[right], 0) + 1
            
            # Shrink window if unique element limit is breached
            while len(freq) > target_k:
                freq[arr[left]] -= 1
                if freq[arr[left]] == 0:
                    del freq[arr[left]]
                left += 1
                
            # Add total possible valid subarrays ending at 'right'
            count += (right - left + 1)
            
        return count

    return atMostK(k) - atMostK(k - 1)

