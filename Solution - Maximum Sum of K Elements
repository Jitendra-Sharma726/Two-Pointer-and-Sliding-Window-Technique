#include <bits/stdc++.h>

using namespace std;

int main() {
    int n, k;
    cin >> n >> k;
    int arr[n];
    for (int i = 0; i < n; i++) {
        cin >> arr[i];
    }
    int i = 0;
    long long sum = 0;
    for (int i = 0; i < k; i++) {
        sum += arr[i];
    }
    long long maxsum = sum;
    int left = 0, right = k;
    while (right < n) {
        sum += arr[right] - arr[left];
        right++;
        left++;
        maxsum = max(maxsum, sum);
    }
    cout << maxsum << endl;
}
