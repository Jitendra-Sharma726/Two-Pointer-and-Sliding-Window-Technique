#include <iostream>
#include <string>

using namespace std;

bool validPalindrome(string s) {
    // Write your code 
    int left = 0, right = s.length()-1;
    int count = 0;
    while(left<right){
        if(s[left]!=s[right]){
            if(s[left]==s[right-1]){
                count++;
                right--;
            }
            else if(s[left+1]==s[right]){
                count++;
                left++;
            }
            else return false;
        }
        else{
            left++;
            right--;
        }
    }
    if(count>1)return false;
    return true;
}

int main() {
  int n;
  cin>>n;
    string s;
    cin >> s;
    cout << (validPalindrome(s) ? "true" : "false") << endl;
    return 0;
}
