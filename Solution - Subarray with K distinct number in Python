def subarraysWithKDistinct(arr, k):
    def atMost(target_k):
        if target_k <= 0:
            return 0
            
        count = 0
        left = 0
        freq = {}
        
        for right in range(len(arr)):
            # Add the current element to the window
            freq[arr[right]] = freq.get(arr[right], 0) + 1
            
            # If we have more than target_k distinct numbers, shrink from the left
            while len(freq) > target_k:
                freq[arr[left]] -= 1
                if freq[arr[left]] == 0:
                    del freq[arr[left]]
                left += 1
                
            # The number of valid subarrays ending at 'right' is (right - left + 1)
            count += (right - left + 1)
            
        return count

    return atMost(k) - atMost(k - 1)

