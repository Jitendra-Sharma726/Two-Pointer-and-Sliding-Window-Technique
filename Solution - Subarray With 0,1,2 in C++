#include <bits/stdc++.h>
using namespace std;

long long countSubarrays(vector < long long > & a) {
    // Write your code here
    int count[3] = {0, 0, 0};
    long long subcount = 0;
    int back=0;
    int n=a.size();
    for(int front=0; front<n; front++) {
        count[a[front]]++;
        while(min({count[0], count[1],count[2]}) != 0) {
            subcount += n-front;
            count[a[back]]--;
            back++;
        }
    }
    return subcount;
}

int main() {
    long long n;
    cin >> n;

    vector < long long > arr(n);
    for (long long i = 0; i < n; i++) {
        cin >> arr[i];
    }

    cout << countSubarrays(arr) << endl;

    return 0;
}
